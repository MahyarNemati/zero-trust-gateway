# Copy to .env and load it however you prefer. Required values have no default.

# --- required ---
ZT_PUBLIC_URL=https://app.example.com
ZT_UPSTREAM_URL=http://127.0.0.1:3000
ZT_POLICY_FILE=./policy.yaml
# 32+ bytes, base64 or hex. Generate: openssl rand -base64 32
ZT_SESSION_SECRET=
ZT_OIDC_ISSUER=https://id.example.com/realms/main
ZT_OIDC_CLIENT_ID=zero-trust-gateway

# --- listeners ---
ZT_LISTEN_ADDR=:8080
# Separate port so /metrics is never reachable through the public listener.
ZT_METRICS_ADDR=:9090
ZT_LOG_LEVEL=info

# --- OIDC ---
# Omit for a public client using PKCE only.
ZT_OIDC_CLIENT_SECRET=
ZT_OIDC_SCOPES=openid,profile,email
ZT_OIDC_GROUPS_CLAIM=groups

# --- sessions ---
# "memory" is per-process: a restart signs everyone out and two replicas do not
# share sessions. Use "redis" for anything real.
ZT_SESSION_STORE=memory
ZT_REDIS_URL=redis://localhost:6379/0
ZT_SESSION_TTL=12h
ZT_SESSION_IDLE_TIMEOUT=1h
ZT_COOKIE_NAME=__Host-zt_session

# --- upstream assertion ---
# Deliberately short: the assertion is minted per request, so it never needs to
# outlive one.
ZT_JWT_TTL=1m
ZT_JWT_AUDIENCE=upstream-api
ZT_JWT_HEADER=X-ZT-Assertion
ZT_JWT_ROTATION_INTERVAL=24h
# Set to pin a static ES256 key (PEM). Omit to generate and rotate in memory.
ZT_JWT_SIGNING_KEY_FILE=

# --- passkeys ---
ZT_PASSKEYS_ENABLED=true
# Must be the registrable domain of ZT_PUBLIC_URL, or WebAuthn refuses.
ZT_WEBAUTHN_RP_ID=app.example.com
ZT_WEBAUTHN_RP_NAME=Example
ZT_STEP_UP_MAX_AGE=15m
